<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navi_home_search"
    app:startDestination="@id/homeSearchFragment">
    <fragment
        android:id="@+id/homeSearchFragment"
        android:name="com.ita.poppop.view.empty.search.SearchFragment"
        android:label="HomeSearchFragment" >
        <argument
            android:name="searchMode"
            app:argType="com.ita.poppop.model.empty.search.SearchMode" />
        <action
            android:id="@+id/action_homeSearchFragment_to_navi_info"
            app:destination="@id/navi_info" >
            <argument
                android:name="popupId"
                app:argType="integer" />
        </action>
    </fragment>
    <include app:graph="@navigation/navi_info" />
</navigation>
