<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white">
    <data>

    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/sh_sv_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="125dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/sh_cl_info_whole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 이미지 화면 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/sh_cl_info_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.ita.poppop.util.StatusBarSpaceView
                        android:id="@+id/sh_sbsv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_story_gradient"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/sh_iv_info_image"
                        android:layout_width="match_parent"
                        android:layout_height="343dp"
                        android:background="#dedede"
                        android:contentDescription="info_img"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 내용 화면 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/sh_cl_info_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/sh_cl_info_image">

                    <TextView
                        android:id="@+id/sh_tv_info_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="#dedede"
                        android:fontFamily="@font/pretendard_semibold"
                        android:letterSpacing="-0.03"
                        android:lineSpacingExtra="10sp"
                        android:textSize="20sp"
                        android:textStyle="normal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/sh_tv_info_location"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="6dp"
                        android:background="#dedede"
                        android:letterSpacing="-0.03"
                        android:lineSpacingExtra="7sp"
                        android:textColor="@color/gray_600"
                        android:textSize="@dimen/text_14"
                        app:layout_constraintBottom_toTopOf="@+id/sh_tv_info_date"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/sh_tv_info_title" />

                    <!-- 날짜 텍스트 -->
                    <TextView
                        android:id="@+id/sh_tv_info_date"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="#dedede"
                        android:letterSpacing="-0.03"
                        android:lineSpacingExtra="7.5sp"
                        android:textColor="@color/gray_900"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/sh_tv_info_location" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/sh_rv_info_story"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/padding_16"
                    android:paddingBottom="30dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/sh_cl_info_content">

                    <include layout="@layout/item_info_story_shimmer" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="match_parent" />

                    <include layout="@layout/item_info_story_shimmer" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="match_parent" />

                    <include layout="@layout/item_info_story_shimmer" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="match_parent" />

                    <include layout="@layout/item_info_story_shimmer" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="match_parent" />

                    <include layout="@layout/item_info_story_shimmer" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:id="@+id/sh_view1"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:background="@color/gray_300"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/sh_rv_info_story" />

                <View
                    android:id="@+id/sh_tv_view2"
                    android:layout_width="70dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="10dp"
                    android:background="#dedede"
                    android:layout_marginStart="@dimen/margin_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/sh_view1" />

                <View
                    android:id="@+id/sh_tv_view3"
                    android:layout_width="70dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/margin_16"
                    android:background="#dedede"
                    app:layout_constraintStart_toEndOf="@+id/sh_tv_view2"
                    app:layout_constraintTop_toTopOf="@+id/sh_tv_view2" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/sh_iv_profile"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginTop="10dp"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="72dp"
                    app:cardBackgroundColor="#D9D9D9"
                    app:strokeColor="@color/transparent"
                    app:layout_constraintStart_toStartOf="@+id/sh_tv_view2"
                    app:layout_constraintTop_toBottomOf="@+id/sh_tv_view2"
                    app:srcCompat="@drawable/_profile_load_icon" />

                <View
                    android:id="@+id/sh_tv_view4"
                    android:layout_width="70dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="18dp"
                    android:background="#dedede"
                    app:layout_constraintStart_toEndOf="@+id/sh_iv_profile"
                    app:layout_constraintTop_toBottomOf="@+id/sh_tv_view3" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/sh_rv_trend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/item_240"
                    android:layout_marginTop="@dimen/margin_12"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/padding_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/sh_tv_view4" >

                    <include layout="@layout/item_home_trend_shimmer" />

                    <Space
                        android:layout_width="@dimen/item_10"
                        android:layout_height="match_parent"/>

                    <include layout="@layout/item_home_trend_shimmer" />

                    <Space
                        android:layout_width="@dimen/item_10"
                        android:layout_height="match_parent"/>

                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>