<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/item_118"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/sh_iv_user_review_poster"
            android:layout_width="@dimen/item_118"
            android:layout_height="@dimen/item_148"
            android:background="#dedede"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/sh_tv_user_review_title"
            android:layout_width="100dp"
            android:layout_height="24dp"
            android:background="#dedede"
            android:layout_marginTop="@dimen/margin_6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sh_iv_user_review_poster" />


        <View
            android:id="@+id/tv_user_review_date"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:background="#dedede"
            android:layout_marginTop="@dimen/margin_6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sh_tv_user_review_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>

