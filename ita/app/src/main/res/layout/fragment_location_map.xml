<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.ita.poppop.util.StatusBarSpaceView
            android:id="@+id/sbsv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:layout_height="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/floatingActionButton"
            android:layout_width="@dimen/item_40"
            android:layout_height="@dimen/item_40"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_20"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="10dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/transparent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sbsv" >
            <ImageButton
                android:id="@+id/ib_cancel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/transparent"
                android:src="@drawable/chevron_left"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- 검색창 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcv_map_search"
            android:layout_width="0dp"
            android:layout_height="@dimen/item_40"
            android:layout_marginStart="@dimen/margin_10"
            android:layout_marginEnd="@dimen/margin_16"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="10dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/transparent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/floatingActionButton"
            app:layout_constraintTop_toBottomOf="@+id/sbsv">


            <TextView
                android:id="@+id/tv_map_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:layout_marginHorizontal="@dimen/margin_16"
                android:layout_marginVertical="@dimen/margin_8"
                android:layout_gravity="center"
                android:text="서울시 강남구"
                android:fontFamily="@font/pretendard_semibold"
                android:textSize="@dimen/text_16"
                android:textColor="#3c3c3c"
                android:letterSpacing="-0.02"
                android:lineSpacingExtra="8sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 지도 화면 -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map_fragment"
            android:name="com.naver.maps.map.MapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 재검색 버튼-->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/acb_rebrowse"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/map_rebrowse_btn_background"
            android:drawableStart="@drawable/map_rebrowse_icon"
            android:drawablePadding="6dp"
            android:paddingHorizontal="@dimen/padding_13"
            android:paddingVertical="8dp"
            android:text="이지역 재검색"
            android:gravity="center"
            android:fontFamily="@font/pretendard_medium"
            android:textStyle="normal"
            android:textSize="13sp"
            android:textColor="@color/gray_900"
            android:letterSpacing="-0.02"
            android:lineSpacingExtra="6.5sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/map_fragment"
            app:layout_constraintEnd_toEndOf="@+id/map_fragment"
            app:layout_constraintTop_toBottomOf="@+id/mcv_map_search"/>


        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_search_tracking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="50dp"
            android:backgroundTint="@color/white"
            android:contentDescription="Tracking"
            app:fabCustomSize="40dp"
            android:src="@drawable/map_tracking_icon"
            app:layout_constraintEnd_toEndOf="@+id/map_fragment"
            app:layout_constraintTop_toBottomOf="@+id/mcv_map_search"
            app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraLarge" />



        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/cl_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/nsv_bottom_sheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:elevation="12dp"
                android:paddingHorizontal="@dimen/item_16"
                app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

                <ImageView
                    android:id="@+id/iv_bottomsheet_bar_icon"
                    android:layout_width="60dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="@dimen/item_16"
                    android:background="@drawable/map_bottomsheet_bar_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/nsv_ss"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingBottom="65dp">

                        <TextView
                            android:id="@+id/tv_message1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="주변 팝업 스토어"
                            android:textColor="@color/black"
                            android:textSize="@dimen/item_24"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                        <TextView
                            android:id="@+id/tv_message2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/item_4"
                            android:text="마음에 들어할 곳들을 추천해봤어요"
                            android:textColor="@color/gray_700"
                            android:textSize="@dimen/text_14"
                            app:layout_constraintStart_toStartOf="@id/tv_message1"
                            app:layout_constraintTop_toBottomOf="@id/tv_message1" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_map"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/item_24"
                            app:layout_constraintTop_toBottomOf="@id/tv_message2" />
                        <!-- <Space
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            app:layout_constraintTop_toBottomOf="@id/rv_map"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" /> -->

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.core.widget.NestedScrollView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
