<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">



        <ImageView
            android:id="@+id/sh_iv_upcoming_poster"
            android:layout_width="@dimen/item_128"
            android:layout_height="@dimen/item_128"
            android:src="#D9D9D9"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/sh_tv_upcoming_location"
            android:layout_width="110dp"
            android:layout_height="24dp"
            android:background="#dedede"
            android:layout_marginStart="@dimen/margin_16"
            app:layout_constraintStart_toEndOf="@id/sh_iv_upcoming_poster"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/sh_tv_upcoming_title"
            android:layout_width="154dp"
            android:layout_height="24dp"
            android:background="#dedede"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/pretendard_semibold"
            android:letterSpacing="-0.02"
            android:lineSpacingExtra="8.5sp"
            android:text="문도 픽사(Mundo Pixar): 픽사, 상상의 세계로"
            android:textColor="@color/black"
            android:textSize="@dimen/text_17"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/sh_iv_upcoming_poster"
            app:layout_constraintTop_toBottomOf="@+id/sh_tv_upcoming_location" />

        <View
            android:id="@+id/sh_tv_upcoming_date"
            android:layout_width="180dp"
            android:layout_height="20dp"
            android:background="#dedede"
            android:layout_marginTop="@dimen/margin_4"
            android:layout_marginStart="@dimen/margin_16"
            android:ellipsize="end"
            android:fontFamily="@font/pretendard_semibold"
            android:maxLines="1"
            android:text="25.05.05 - 25.06.29"
            android:textColor="@color/gray_800"
            android:textSize="@dimen/text_13"
            android:letterSpacing="-0.02"
            android:lineSpacingExtra="6.5sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/sh_iv_upcoming_poster"
            app:layout_constraintTop_toBottomOf="@+id/sh_tv_upcoming_title" />


        <View
            android:layout_width="80dp"
            android:layout_height="24dp"
            android:background="#dedede"
            android:layout_marginStart="@dimen/margin_16"
            app:cardElevation="0dp"
            app:cardCornerRadius="5dp"
            app:strokeColor="@color/transparent"
            app:cardBackgroundColor="@color/gray_400"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sh_iv_upcoming_poster">




        </View>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>