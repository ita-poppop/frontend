<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white">
    <data>

    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/sh_sv_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="125dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/sh_cl_info_review"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.ita.poppop.util.StatusBarSpaceView
                    android:id="@+id/sh_sbsv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_story_gradient"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/sh_cl_review"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/sh_iv_profile"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="5dp"
                        app:cardBackgroundColor="#D9D9D9"
                        app:cardCornerRadius="72dp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="@+id/sh_cl_review"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/_profile_load_icon"
                        app:strokeColor="@color/transparent" />

                    <View
                        android:id="@+id/sh_tv_view4"
                        android:layout_width="70dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="10dp"
                        android:background="#dedede"
                        app:layout_constraintStart_toEndOf="@+id/sh_iv_profile"
                        app:layout_constraintTop_toTopOf="@+id/sh_iv_profile" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/sh_rv_trend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/item_240"
                        android:layout_marginTop="@dimen/margin_12"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/padding_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/sh_tv_view4" >

                        <include layout="@layout/item_home_trend_shimmer" />

                        <Space
                            android:layout_width="@dimen/item_10"
                            android:layout_height="match_parent"/>

                        <include layout="@layout/item_home_trend_shimmer" />

                        <Space
                            android:layout_width="@dimen/item_10"
                            android:layout_height="match_parent"/>

                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/sh_cl_review2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/sh_cl_review">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/sh_iv_profile2"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="5dp"
                        app:cardBackgroundColor="#D9D9D9"
                        app:cardCornerRadius="72dp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="@+id/sh_cl_review2"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/_profile_load_icon"
                        app:strokeColor="@color/transparent" />

                    <View
                        android:id="@+id/sh_tv_view42"
                        android:layout_width="70dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="10dp"
                        android:background="#dedede"
                        app:layout_constraintStart_toEndOf="@+id/sh_iv_profile2"
                        app:layout_constraintTop_toTopOf="@+id/sh_iv_profile2" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/sh_rv_trend2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/item_240"
                        android:layout_marginTop="@dimen/margin_12"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/padding_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/sh_tv_view42" >

                        <include layout="@layout/item_home_trend_shimmer" />

                        <Space
                            android:layout_width="@dimen/item_10"
                            android:layout_height="match_parent"/>

                        <include layout="@layout/item_home_trend_shimmer" />

                        <Space
                            android:layout_width="@dimen/item_10"
                            android:layout_height="match_parent"/>

                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>