<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="13dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sh_iv_profile"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="72dp"
            app:cardBackgroundColor="#D9D9D9"
            app:strokeColor="@color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/_profile_load_icon" />


        <TextView
            android:id="@+id/sh_tv_story_name"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:background="#dedede"
            android:fontFamily="@font/pretendard_medium"
            android:letterSpacing="-0.02"
            android:lineSpacingExtra="6.5sp"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/sh_iv_profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>