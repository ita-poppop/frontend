<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">



        <ImageView
            android:id="@+id/sh_iv_review_poster"
            android:layout_width="@dimen/item_128"
            android:layout_height="@dimen/item_128"
            android:src="#D9D9D9"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/sh_tv_review_location"
            android:layout_width="100dp"
            android:layout_height="24dp"
            android:background="#dedede"
            android:layout_marginStart="@dimen/margin_16"
            app:layout_constraintStart_toEndOf="@id/sh_iv_review_poster"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/sh_tv_review_title"
            android:layout_width="154dp"
            android:layout_height="24dp"
            android:background="#dedede"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_marginTop="@dimen/margin_4"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/sh_iv_review_poster"
            app:layout_constraintTop_toBottomOf="@+id/sh_tv_review_location" />

        <TextView
            android:id="@+id/sh_tv_review_date"
            android:layout_width="120dp"
            android:layout_height="24dp"
            android:background="#dedede"
            android:layout_marginTop="@dimen/margin_4"
            android:layout_marginStart="@dimen/margin_16"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/sh_iv_review_poster"
            app:layout_constraintTop_toBottomOf="@+id/sh_tv_review_title" />

        <TextView
            android:id="@+id/sh_tv_review_comment"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/margin_16"
            android:background="#dedede"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/sh_iv_review_poster" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>